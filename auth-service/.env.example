# Database Configuration
# Update these values with your actual database credentials
DATABASE_URL=jdbc:mysql://localhost:3306/quantity_measurement_auth_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DATABASE_USERNAME=your_database_username
DATABASE_PASSWORD=your_database_password
DATABASE_DRIVER=com.mysql.cj.jdbc.Driver

# JWT Configuration
# Generate a strong secret key and set expiration time in milliseconds
JWT_SECRET=your_base64_encoded_jwt_secret
JWT_EXPIRATION=86400000

# OAuth2 GitHub Configuration
# Register your app at https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_SCOPE=user:email,read:user
GITHUB_REDIRECT_URI=http://localhost:8081/login/oauth2/code/github

# OAuth2 Google Configuration
# Register your app at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_SCOPE=email,profile
GOOGLE_REDIRECT_URI=http://localhost:8081/login/oauth2/code/google

# CORS Configuration
# Update with your frontend URL in production
CORS_ALLOWED_ORIGINS=http://localhost:4200
OAUTH2_REDIRECT_URI=http://localhost:4200/oauth2/callback

# Eureka Configuration
# Update with your Eureka server URL
EUREKA_SERVICE_URL=http://localhost:8761/eureka/

# Server Configuration
SERVER_PORT=8081

